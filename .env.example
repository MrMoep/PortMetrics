# Umgebung: development | test | production
APP_ENV=development

# Produktiv-DB (Unraid PostgreSQL 18) — nur in production verwenden
DATABASE_URL=postgresql+psycopg://user:password@host.docker.internal:5432/portmetrics

# Test-/Dev-DB — pytest und lokale Entwicklung
TEST_DATABASE_URL=postgresql+psycopg://user:password@host.docker.internal:5432/portmetrics_test

# Ghostfolio
GHOSTFOLIO_URL=http://ghostfolio:3333
GHOSTFOLIO_ACCESS_TOKEN=
# Optional für Paperless→Ghostfolio Import
GHOSTFOLIO_DEFAULT_ACCOUNT_ID=
GHOSTFOLIO_DATA_SOURCE=YAHOO

# Paperless NGX
PAPERLESS_URL=http://paperless:8000
PAPERLESS_TOKEN=
# Optional: nur Dokumente mit diesem Tag-Namen syncen
PAPERLESS_TAG=
# Shared secret for POST /api/webhooks/paperless (header X-PortMetrics-Secret)
PAPERLESS_WEBHOOK_SECRET=
# Optional catch-up pull (minutes); 0 = disabled
PAPERLESS_SYNC_INTERVAL_MINUTES=0

# App
WEB_DIST_DIR=/app/web/dist
LOG_DIR=/app/logs
LOG_LEVEL=INFO
# Comma-separated browser origins for CORS (NPM / reverse proxy), e.g.:
# CORS_ORIGINS=https://portmetric.mrcarott.de
CORS_ORIGINS=

# Background jobs (im selben Container via APScheduler)
SCHEDULER_ENABLED=true
SYNC_INTERVAL_MINUTES=60
METRICS_INTERVAL_MINUTES=60
