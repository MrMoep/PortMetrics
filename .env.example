# Umgebung: development | test | production
APP_ENV=development

# Produktiv-DB (Unraid PostgreSQL 18) — nur in production verwenden
DATABASE_URL=postgresql+psycopg://user:password@host.docker.internal:5432/portmetrics

# Test-/Dev-DB — pytest und lokale Entwicklung
TEST_DATABASE_URL=postgresql+psycopg://user:password@host.docker.internal:5432/portmetrics_test

# Ghostfolio
GHOSTFOLIO_URL=http://ghostfolio:3333
GHOSTFOLIO_ACCESS_TOKEN=

# Paperless NGX
PAPERLESS_URL=http://paperless:8000
PAPERLESS_TOKEN=

# App
LOG_LEVEL=INFO
